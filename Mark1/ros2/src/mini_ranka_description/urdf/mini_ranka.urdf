    <link name="base_link" />

    <!-- ==================== joint2: shoulder pitch ====================
         The belt OUTPUT, i.e. the arm itself — this is the joint fk() means by
         q2, not the motor (see joint2_belt). Axis negated from the export's
         `bearing_revolute` so +q2 raises the arm. -->
    <joint name="joint2" type="revolute">
        <origin xyz="-5.18498e-18 1.38778e-17 4.33681e-19" rpy="1.01109e-14 7.90371e-15 -1.5708" />
        <axis xyz="0 0 -1" />
        <limit lower="-2.0" upper="2.0"
               effort="5.0" velocity="10.0" />
        <parent link="bearring" />
        <child link="link2" />
    </joint>
    <joint name="tool_joint" type="fixed">
        <origin xyz="-2.77556e-17 0.0158 0.2" rpy="1.26218e-29 -1.57772e-30 2.46519e-32" />
        <axis xyz="0 0 1" />
        <parent link="link3" />
        <child link="tool_link" />
    </joint>
    <joint name="fastened_1" type="fixed">
        <origin xyz="-6.15827e-18 -3.36576e-18 6.93889e-18" rpy="6.43662e-15 -6.43662e-15 -1.5708" />
        <axis xyz="-0 -0 -1" />
        <parent link="base_link" />
        <child link="base" />
    </joint>
    <joint name="fastened_2" type="fixed">
        <origin xyz="1.38778e-17 0 -0.011" rpy="1.5708 -5.54861e-16 -3.14159" />
        <axis xyz="0 1 0" />
        <parent link="gbm2804_rotor" />
        <child link="link3" />
    </joint>
    <joint name="fastened_3" type="fixed">
        <origin xyz="-3.36576e-18 6.07153e-19 0.03" rpy="-3.14159 1.24633e-15 -2.32179e-15" />
        <axis xyz="0 0 1" />
        <parent link="base" />
        <child link="gm3506_stator_1" />
    </joint>
    <joint name="fastened_4" type="fixed">
        <origin xyz="0.02 -0.0245 6.93889e-18" rpy="-1.43038e-16 5.92868e-16 1.69309e-15" />
        <axis xyz="1.73472e-16 1 -0" />
        <parent link="link1_body" />
        <child link="link1_attachment" />
    </joint>
    <joint name="fastened_5" type="fixed">
        <origin xyz="-0.0778938 1.38778e-17 0.0281002" rpy="1.5708 5.43881e-17 -1.09899e-16" />
        <axis xyz="0 0 1" />
        <parent link="link1_attachment" />
        <child link="gm3506_stator" />
    </joint>
    <joint name="fastened_6" type="fixed">
        <origin xyz="-1.38778e-17 -0.2 -0.002" rpy="-3.14159 -8.84709e-17 -2.77556e-16" />
        <axis xyz="0 0 1" />
        <parent link="link2" />
        <child link="gbm2804_stator" />
    </joint>
    <joint name="fastened_7" type="fixed">
        <origin xyz="-9.18861e-18 0.0028 0.0365" rpy="1.5708 1.1437e-14 3.14159" />
        <axis xyz="0 0 -1" />
        <parent link="link1_body" />
        <child link="bearring" />
    </joint>
    <joint name="fastened_8" type="fixed">
        <origin xyz="2.87792e-19 -8.01187e-32 -0.014" rpy="3.14159 -5.13683e-16 1.5708" />
        <axis xyz="0 0 -1" />
        <parent link="gm3506_rotor_1" />
        <child link="link1_body" />
    </joint>
    <joint name="fastened_9" type="fixed">
        <origin xyz="0 0 -0.014" rpy="0 1.5708 1.5708" />
        <axis xyz="-1 -0 -0" />
        <parent link="gm3506_rotor" />
        <child link="gt2_20t" />
    </joint>
    <!-- ==================== joint3: elbow pitch ====================
         The export's axis already comes out (0,-1,0) in world once joint1 has
         been yawed, which is what fk() wants — sign left alone. -->
    <joint name="joint3" type="revolute">
        <origin xyz="-1.38778e-17 2.77556e-17 -0.004" rpy="1.52766e-14 -1.39216e-15 2.07169e-15" />
        <axis xyz="-0 -0 1" />
        <limit lower="-2.0" upper="2.0"
               effort="5.0" velocity="10.0" />
        <parent link="gbm2804_stator" />
        <child link="gbm2804_rotor" />
    </joint>

    <!-- ==================== joint1: base yaw ====================
         The 3.14159265358979 yaw in the origin is the export-zero -> fk-zero half turn: it
         swings the whole arm from -X to +X. The negated axis then makes +q1 CCW
         about world +Z, matching t1 = atan2(y, x). -->
    <joint name="joint1" type="revolute">
        <origin xyz="4.92855e-18 5.38849e-17 -0.0038" rpy="0 0 3.14159265358979" />
        <axis xyz="0 0 -1" />
        <limit lower="-2.0" upper="2.0"
               effort="5.0" velocity="10.0" />
        <parent link="gm3506_stator_1" />
        <child link="gm3506_rotor_1" />
    </joint>

    <!-- ============== joint2_belt: GM3506 pulley (not a DOF) ==============
         The export gives the J2 motor its own free joint, but the belt ties it
         to the arm. Mimicking joint2 at 3.0 keeps the twin honest:
         one slider, and the pulley visibly spins 3x the arm like the real one.
         Left `continuous` on purpose — at the ratio it runs past joint2's
         limits, so a bounded copy of them would be violated at full travel. -->
    <joint name="joint2_belt" type="continuous">
        <origin xyz="-5.75928e-16 0 -0.0038" rpy="-3.72737e-16 -2.02003e-14 1.65079e-15" />
        <axis xyz="0 0 1" />
        <mimic joint="joint2" multiplier="3.0" offset="0" />
        <parent link="gm3506_stator" />
        <child link="gm3506_rotor" />
    </joint>
</robot>
